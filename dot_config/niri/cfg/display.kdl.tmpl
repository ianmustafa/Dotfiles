// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

{{ if eq .chezmoi.hostname "Archian" -}}
output "HDMI-A-1" {
    mode "2560x1080@60.000"
    scale 1
}
{{- else if eq .chezmoi.hostname "Thinkian" -}}
output "eDP-1" {
    mode "1920x1080@60.001"
    scale 1
}
{{- end }}

layout {

    focus-ring {
        active-color   "#fd4e50"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#fd4e50"
        inactive-color "#291414"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#29141470"
    }

    tab-indicator {
        active-color   "#fd4e50"
        inactive-color "#990002"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#fd4e5080"
    }
}

recent-windows {
    highlight {
        active-color "#fd4e50"
        urgent-color "#fd4663"
    }
}

theme = Darkian

font-family = "VictorMono Nerd Font"
font-style = SemiBold
font-size = 11
adjust-cell-height = 5%

cursor-style = block
cursor-style-blink = true
shell-integration = zsh
shell-integration-features = "ssh-env,ssh-terminfo,no-cursor"

# window-width = 120
# window-height = 25
window-padding-x = 4
window-padding-y = 2

background-opacity = 0.96
